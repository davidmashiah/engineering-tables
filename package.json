  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./steam": "./src/steam.js",
    "./distributions": "./src/dist.js",
    "./normal": "./src/stats.js",
    "./units": "./src/units.js",
    "./viscosity": "./src/viscosity.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
