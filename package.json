  "homepage": "https://taueng.com/en/tables/steam-tables/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidmashiah/engineering-tables.git"
  },
  "bugs": {
    "url": "https://github.com/davidmashiah/engineering-tables/issues"
  },
  "engines": {
